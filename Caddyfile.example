# Optional single-origin proxy: /mail/* and /api/* -> mail, everything else -> UI.
# Enable with: docker compose --profile proxy up -d
# For public exposure, add basic auth:
#   caddy hash-password --plaintext 'your-password'
# and uncomment the block below.
:8080 {
	encode zstd gzip
	# basic_auth {
	# 	mail $2a$14$REPLACE_WITH_BCRYPT_HASH
	# }
	handle /mail/* {
		reverse_proxy mail:8081
	}
	handle /api/* {
		reverse_proxy mail:8081
	}
	handle {
		reverse_proxy ui:8501
	}
}
