# --- Onyx ---
ONYX_TAG=v5.1.3
ONYX_API_PORT=8080
ONYX_WEB_PORT=3000
USER_AUTH_SECRET=change-me-to-a-long-random-string
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=postgres
OPENSEARCH_ADMIN_PASSWORD=change-me-search
OPENSEARCH_JAVA_OPTS="-Xms2g -Xmx2g"

# --- retrieval adapter ---
RETRIEVAL_PORT=8082
ONYX_API_KEY=
RERANK_URL=http://host.docker.internal:9294/v1/rerank
RERANK_MODEL=qwen3-reranker-0.6b
CANDIDATES=30

# --- ingest ---
# absolute path or relative to deploy/backend
DATA_DIR=../../data
MAIL_PUBLIC_URL=http://localhost:8081
# leave empty to use Onyx's default connector-credential pair
ONYX_CC_PAIR_ID=
