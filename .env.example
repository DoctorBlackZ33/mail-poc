# Copy to .env. Compose reads it automatically.

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
PGHOST=db
PGDATABASE=mail
PGUSER=postgres

# --- llama.cpp endpoints (OpenAI-compatible HTTP) ---------------------------
# With `docker compose --profile llama up -d` these resolve inside the network.
# Point them at another host if inference runs elsewhere.
EMBED_URL=http://embed:8080/v1/embeddings
EMBED_MODEL=Qwen3-Embedding-0.6B
RERANK_URL=http://rerank:8080/v1/rerank
RERANK_MODEL=Qwen3-Reranker-0.6B
CHAT_URL=http://chat:8080/v1/chat/completions
CHAT_MODEL=gemma-4-E4B-it

# --- mailbox ---------------------------------------------------------------
# maildir: read ./maildir/{new,cur}; replies are written to ./maildir/Sent
# imap:    read an IMAP mailbox and reply over SMTP
MAIL_SOURCE=maildir
MAILDIR=/maildir
MAIL_DOMAIN=mail.local

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
# Folder the bot watches for questions (a filter/rule can move mail here).
IMAP_QUESTION_MAILBOX=INBOX

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- retrieval -------------------------------------------------------------
TOP_K=6
CANDIDATES=30
EMBED_BATCH=8
POLL_SECONDS=60
